+/* === Dashboard: day strip, top 3, yesterday recap === */
+.empty-inline{color:#7a8493;font-size:13px;padding:10px 2px;line-height:1.5}
+.day-strip-card{padding:16px 18px}
+.day-strip{display:flex;gap:8px;overflow-x:auto;padding-bottom:2px}
+.day-chip{flex:1;min-width:56px;display:flex;flex-direction:column;align-items:center;gap:4px;border:1px solid #e4e6ea;background:#fbfbfa;border-radius:13px;padding:10px 6px;cursor:pointer;color:#6d7582}
+.day-chip small{font-size:10px;text-transform:uppercase;letter-spacing:.04em;color:#9aa3b2}
+.day-chip .chip-num{font-weight:800;font-size:14px;color:#172033}
+.day-chip .chip-mood{font-size:17px;line-height:1}
+.day-chip.has-data{border-color:#d7dbe1;background:#fff}
+.day-chip.is-today{border-color:#172033;box-shadow:0 0 0 2px #17203314}
+.day-chip.is-today .chip-num{color:#172033}
+
+.top-priorities .priority-list{display:grid;gap:9px}
+.priority-item{display:flex;align-items:center;gap:11px;width:100%;border:1px solid #e3e6ea;background:#fafafa;border-radius:12px;padding:12px 14px;cursor:pointer;text-align:left;font:inherit;color:#172033}
+.priority-check{flex:none;width:20px;height:20px;border-radius:7px;border:2px solid #c7ccd4;display:grid;place-items:center;color:#fff}
+.priority-item.done{background:#eef5ec;border-color:#cdddc9}
+.priority-item.done .priority-check{background:#3fa142;border-color:#3fa142}
+.priority-item.done .priority-text{color:#4c5a4c;text-decoration:line-through;text-decoration-color:#9db99b}
+.priority-text{font-weight:600;font-size:14px}
+
+.recap-card .recap-body{display:flex;gap:22px;align-items:center}
+.recap-score{flex:none;display:flex;flex-direction:column;align-items:center;gap:8px;width:112px}
+.score-ring{width:96px;height:96px;border-radius:50%;display:grid;place-items:center}
+.score-inner{width:74px;height:74px;border-radius:50%;background:#fff;display:flex;align-items:baseline;justify-content:center;gap:1px}
+.score-inner b{font-size:22px;color:#172033}
+.score-inner small{font-size:11px;color:#7a8493}
+.score-label{font-size:11px;color:#7a8493;font-weight:700;text-align:center}
+.recap-bars{flex:1;display:grid;gap:10px;min-width:0}
+.recap-row{display:flex;align-items:center;gap:10px}
+.recap-row .row-lbl{width:96px;flex:none;font-size:13px;font-weight:700;color:#4f5968}
+.recap-row .track{flex:1;height:8px;background:#ececea;border-radius:99px;overflow:hidden}
+.recap-row .fill{height:100%;border-radius:99px}
+.recap-row .val{width:44px;flex:none;text-align:right;font-size:12px;font-weight:700;color:#7a8493}
+.recap-highlight{margin:16px 0 0;padding-top:14px;border-top:1px solid #f0f1f3;font-size:13px;color:#4f5968}
+@media(max-width:560px){.recap-card .recap-body{flex-direction:column;align-items:stretch}.recap-score{flex-direction:row;width:auto;justify-content:center}}
+
+/* === New-day / edit-day modal === */
+.modal-overlay{position:fixed;inset:0;background:#111827bf;display:flex;align-items:flex-start;justify-content:center;padding:5vh 16px;z-index:50;overflow-y:auto}
+.modal{background:#fff;border-radius:20px;width:100%;max-width:720px;box-shadow:0 30px 70px #0004;display:flex;flex-direction:column;max-height:90vh}
+.modal-header{display:flex;justify-content:space-between;align-items:flex-start;padding:20px 22px 16px;border-bottom:1px solid #f0f1f3}
+.modal-date{display:flex;align-items:center;gap:8px;margin-top:6px;color:#172033}
+.modal-date input{border:1px solid #dfe3e8;border-radius:9px;padding:7px 9px;font:inherit}
+.modal-body{padding:20px 22px;overflow-y:auto;display:grid;gap:22px}
+.modal-section h4{margin:0 0 12px;font-size:13px;text-transform:uppercase;letter-spacing:.05em;color:#7b8494}
+.modal-grid{grid-template-columns:repeat(3,1fr)}
+.advanced-toggle{border:1px dashed #d7dbe1;background:transparent;border-radius:12px;padding:11px 14px;display:flex;align-items:center;gap:8px;color:#4f5968;font-weight:700;font-size:13px;cursor:pointer;width:100%}
+.advanced-toggle svg{transition:transform .15s ease}
+.advanced-toggle svg.rot{transform:rotate(180deg)}
+.modal-footer{display:flex;justify-content:flex-end;align-items:center;gap:10px;padding:16px 22px;border-top:1px solid #f0f1f3}
+.modal-error{color:#ef4444;font-size:12px;font-weight:700;margin-right:auto}
+@media(max-width:640px){.modal-overlay{padding:0}.modal{max-width:none;height:100vh;max-height:100vh;border-radius:0}.modal-grid{grid-template-columns:1fr 1fr}.modal-header{flex-wrap:wrap;gap:10px}}
